---
/**
 * Link-in-bio page for https://shauna.dev/ — the whole site, served at the root.
 *
 * Copied out of the portfolio-2026 repo, where it lived at /links and reached
 * shauna.dev through a host rewrite in netlify.toml. Here it is just the index.
 * PROD STILL SERVES THE OTHER COPY until this repo gets its own Netlify site;
 * see README.md before editing, or your change won't go live.
 *
 * Canonical is shauna.dev, which is now simply this page's own URL. While both
 * copies are deployed the canonical is also what keeps shauna.digital/links
 * from competing with it — do not swap it for a `noindex`, that would
 * de-index shauna.dev itself.
 *
 * Deliberately standalone: no Layout.astro (that carries the portfolio nav,
 * the scroll-progress bar and an og:url hardcoded to shauna.digital). Only
 * global.css is imported, so the design tokens stay single-sourced.
 */
import '../styles/global.css';
import LogoS from '../components/LogoS.astro';
import links from '../data/links.json';

const { meta, contact, socials, bars, upcoming, writing } = links;

// --- Writing section: hardcoded, and that is the tradeoff ----------------
// In portfolio-2026 these came from getCollection('blog'), so the count and
// read time could not go stale. That required this repo to carry all 13 posts
// and their MDX components purely to count them — for a number that changes a
// few times a year. Decoupled 2026-08-13; the blog now lives only in
// portfolio-2026. Cost: publishing a post there silently makes this page wrong
// until links.json is updated by hand.
const postCount = writing.postCount;
const latestUrl = `https://shauna.digital/blog/${writing.latestPostSlug}`;
const latestReadTime = writing.latestReadTime;

/**
 * Icon artwork, keyed by links.json `socials[].icon`.
 *
 * ALL SEVEN ARE THE OFFICIAL MARKS, per CLAUDE.md. The mockup's five line
 * drawings (Instagram, TikTok, Pinterest, Substack, and a Georgia "E" for
 * Etsy) were approximations and were replaced 2026-08-12.
 *
 * Geometry is the unmodified official glyph, taken from Simple Icons, which
 * tracks each brand's published brand kit. Each is a single path on a 24x24
 * viewBox.
 *
 * Rendered MONOCHROME via fill="currentColor", not in brand colours. Two
 * reasons, and both matter:
 *   - the palette is locked to black + white + one teal (DECISIONS.md), and
 *     an Instagram gradient or TikTok's cyan/red would break it outright;
 *   - .ico inverts to a white glyph on an ink fill on hover, which only
 *     works if the mark inherits colour.
 * Every one of these brands permits a solid one-colour version of the mark
 * for exactly this case. The glyphs are unmodified, which is the part their
 * guidelines actually police.
 *
 * The marks remain the trademarks of their owners; they are used here only
 * to link to Shauna's own profiles.
 */
const ICONS: Record<string, string> = {
