<style>
  /* The S body LEADS the arrival: it slides in from the left and settles first,
     so the mark reads as one object arriving at speed rather than a static S
     with streaks tacked on. transform-box: fill-box keeps the % relative to the
     body's own box; `both` holds the landed state. */
  .is-animated .s-body {
    transform-box: fill-box;
    animation: s-arrive 0.8s var(--ease) both;
  }
  @keyframes s-arrive {
    from { opacity: 0; transform: translateX(-45%) scale(0.92); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
  }

  /* The streaks are the TRAIL catching up: they fly in from further left,
     staggered top to bottom, landing just after the body has settled (the
     0.12s base delay). transform-box: fill-box, so the % is relative to the
     streak, not the whole 1237-unit viewBox. `both` holds the landed state. */
  .is-animated .s-streak {
    transform-box: fill-box;
    animation: streak-in 0.65s var(--ease) both;
    animation-delay: calc(0.18s + var(--i) * 0.085s);
  }
  @keyframes streak-in {
    from { opacity: 0; transform: translateX(-320%); }
    to   { opacity: 1; transform: translateX(0); }
  }
</style>

<script>
  /* Replay the entrance on hover/focus of the logo. Pure enhancement layered on
     top of the load animation: we strip the inline `animation:none`, force a
     reflow, then hand the elements back to the CSS rule above, which restarts it
     (delays and stagger included). Bundled by Astro (not inline), so it stays
     within the tight CSP. Reduced-motion is respected globally in CSS, but we
     also bail here so we never even touch the DOM for those users. */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll('svg.is-animated').forEach((svg) => {
    const hotspot = svg.closest('a') ?? svg;
    const replay = () => {
      if (reduce.matches) return;
      svg.querySelectorAll('.s-body, .s-streak').forEach((el) => {
        el.style.animation = 'none';
        void el.getBoundingClientRect(); // force reflow so the restart takes
        el.style.animation = '';
      });
    };
    hotspot.addEventListener('mouseenter', replay);
    hotspot.addEventListener('focusin', replay);
  });
</script>
