---
/**
 * The "S" logomark. Same artwork as public/favicon.svg, but:
 *  - viewBox trimmed to the mark's real ink bounds (1237x1185+136+166 of a
 *    1500x1500 canvas) so a CSS height is true mark height, not padding;
 *  - fill="currentColor" instead of a hardcoded #2C8C99, so it inherits the
 *    nav's colour and flips to white on the teal footer bar for free;
 *  - the artwork is SPLIT into the S body (which keeps its two interior
 *    counters, so fill-rule="evenodd" still punches them out) and the six
 *    speed-streaks, so the streaks can animate independently. Reassembled the
 *    two render identically to the original single path.
 *
 * animate: streaks stream in from the left on load, one-shot and staggered
 * top to bottom. Off by default so any other use of the mark stays static.
 * prefers-reduced-motion is handled globally (global.css kills all animation).
 */
interface Props { class?: string; animate?: boolean }
const { class: className, animate = false } = Astro.props;
